#!/bin/bash
# Managed by Ansible (roles/claude_wrapper). Do not edit by hand.
#
# `claude ARGS` runs as `caveman claude ARGS`.
#
# caveman finds Claude Code with a plain PATH lookup for `claude`, which
# lands back on this wrapper, either directly or through the
# ~/.local/bin/claude symlink chezmoi points here. The marker variable
# breaks that loop: on the second pass, exec the real binary. Children
# inherit the marker, so a `claude` started from inside a session is not
# wrapped a second time.
set -euo pipefail

self="$(realpath "${BASH_SOURCE[0]}")"

if [ -n "${CLAUDE_CAVEMAN_WRAPPED:-}" ]; then
  # First `claude` on PATH that is not this script (symlinks included).
  while IFS= read -r candidate; do
    [ "$(realpath "$candidate" 2>/dev/null || true)" = "$self" ] && continue
    exec "$candidate" "$@"
  done < <(type -ap claude)
  # The native installer's own tree, newest first. On Linux, chezmoi's
  # symlink replaces the native launcher on PATH, so this is how the real
  # binary is found there.
  for version in $(ls -1 "$HOME/.local/share/claude/versions" 2>/dev/null | sort -rV); do
    candidate="$HOME/.local/share/claude/versions/$version"
    [ -x "$candidate" ] && exec "$candidate" "$@"
  done
  echo "claude: no Claude Code binary found other than $self" >&2
  exit 127
fi

export CLAUDE_CAVEMAN_WRAPPED=1
exec {{ claude_wrapper_caveman_bin }} claude "$@"
