{{- /*
  ~/.zshenv — PLAN.MD task 2.6.

  Replaces the Home-Manager-generated ~/.zshenv, which did nothing but source
  a /nix/store/...-hm-session-vars.sh and set SSH_AUTH_SOCK. Every variable
  below is transcribed from that file as it existed on the darwin host on
  2026-09-23; the Nix store paths are replaced with in-tree assets.

  .zshenv is read by EVERY zsh (scripts, non-interactive ssh, subshells), so
  keep it to exports — no output, no compinit, no command substitution that
  can be slow. Interactive setup belongs in ~/.config/zsh/*.zsh, loaded from
  ~/.zshrc.
*/ -}}
# Managed by chezmoi (source: chezmoi/dot_zshenv.tmpl). Do not edit in place.

# ── XDG ──────────────────────────────────────────────────────────────────
# Home Manager exported these unconditionally. Keeping them explicit means
# every tool agrees on the paths this repo assumes, rather than relying on
# each one's built-in default.
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_BIN_HOME="$HOME/.local/bin"

export EDITOR="vim"

# ── lazygit ──────────────────────────────────────────────────────────────
# catppuccin-theme.nix set this so lazygit reads our config *and* the theme
# the switcher flips. theme.yml is a symlink to theme.{dark,light}.yml, both
# of which .chezmoiexternal.toml vendors.
#
# NOTE (carried-forward gap, PLAN.MD phase 6): nothing owns the theme.yml
# symlink yet. Until something seeds it, lazygit errors out on a fresh host.
export LG_CONFIG_FILE="$XDG_CONFIG_HOME/lazygit/config.yml,$XDG_CONFIG_HOME/lazygit/theme.yml"

# ── catppuccin assets ────────────────────────────────────────────────────
# These two came from the upstream catppuccin Home Manager module
# (autoEnable), not from anything in modules/. Both pointed at Nix store
# paths for files that are generated by `whiskers` at build time rather than
# committed upstream, so there is no raw.githubusercontent URL to pin them
# to — unlike every other asset they are vendored in-tree, byte-for-byte from
# the store paths that were live at migration time. See PLAN.MD task 2.6.
#
# theme-switcher never flipped these (it only handles tmux/kitty), so mocha
# is the observed behaviour and stays the default. The latte counterparts are
# vendored alongside so phase 6 can wire up the light path.
export FZF_DEFAULT_OPTS_FILE="$XDG_CONFIG_HOME/fzf/catppuccin-mocha.rc"
export GLAMOUR_STYLE="$XDG_CONFIG_HOME/glamour/catppuccin-mocha.json"

# ── claude headroom ──────────────────────────────────────────────────────
# From modules/home/claude.nix (headroom.enable). The wrapper script itself
# is task 2.10's; this is only the port it listens on.
export HEADROOM_PORT="8787"

{{ if eq .chezmoi.os "linux" -}}
# ── Wayland/Electron (Linux only) ────────────────────────────────────────
# common-home.nix exported these on every platform, including macOS, where
# they are meaningless. Scoped to Linux here.
export NIXOS_OZONE_WL="1"
export MOZ_ENABLE_WAYLAND="1"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
export ELECTRON_OZONE_PLATFORM_HINT="auto"

# ── ssh-agent (macOS) ────────────────────────────────────────────────────
# macOS has no user systemd; the agent socket lives in the per-user temp dir.
# On Linux this is exported by keychain instead (see 40-tools.zsh), so the
# block is darwin-only. Guard matches the generated file: leave an inherited
# socket from an ssh connection alone.
if [ -z "$SSH_AUTH_SOCK" ] || [ -z "$SSH_CONNECTION" ]; then
  export SSH_AUTH_SOCK="$(getconf DARWIN_USER_TEMP_DIR)/ssh-agent"
fi
{{- end }}

# ── secrets ──────────────────────────────────────────────────────────────
# Was an agenix secret decrypted to ~/.envvars.sh. agenix is gone; PLAN.MD
# phase 5 decides what writes this file. The guard is unchanged, so the file
# simply does not exist until then.
[ -f "$HOME/.envvars.sh" ] && . "$HOME/.envvars.sh"
