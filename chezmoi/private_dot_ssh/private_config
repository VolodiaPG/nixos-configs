# ~/.ssh/config — PLAN.MD task 2.3.
#
# This is the concatenation Home Manager actually produced: the explicit
# `programs.ssh.settings."*"` block from modules/home/common-home.nix first,
# then static/config.ssh verbatim. ORDER IS LOAD-BEARING: ssh_config takes
# the FIRST value seen for each keyword, so the block below wins over the
# second `Host *` for AddKeysToAgent / Compression / ForwardAgent.

Include ~/.ssh/config.d/*.conf

# Alias for the gateway (not really needed, but convenient)
Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent yes
    Compression yes
    IgnoreUnknown UseKeychain
    UseKeychain yes


Host storagebox
    Hostname u593939.your-storagebox.de
    Port 23
    User u593939
    IdentityFile ~/.ssh/id_ed25519
