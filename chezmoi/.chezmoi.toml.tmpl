{{- /*
     chezmoi config template — task 2.1 of PLAN.MD.

     Every value below has a default derived from `.chezmoi.os` /
     `.chezmoi.hostname`, so an interactive `chezmoi init` is all Enter.

     For a non-interactive init, the flag is --promptDefaults:

       chezmoi init --source=<repo> --promptDefaults

     All three of the following were verified against chezmoi 2.72.2, so
     that nobody has to rediscover them:

       * --no-tty does NOT make prompt* fall back to defaults. It fails with
         `error calling promptStringOnce: EOF`. Neither does piping stdin,
         which fails with `could not open a new TTY`. Only --promptDefaults
         works.
       * --promptString is silently IGNORED for promptStringOnce when
         combined with --promptDefaults — the default wins and no error is
         raised. So every default below must be correct on its own; do not
         rely on overriding one from the command line.
       * Values are sticky once written to ~/.config/chezmoi/chezmoi.toml:
         promptStringOnce only prompts for keys not already present. To
         re-derive them, delete that file and init again.

     `email` / `signing_key` are the same source of truth as config.nix's
     `me` attrset and ansible/inventory/group_vars/all/main.yml. If you
     change one, change all three.
*/ -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}

{{- /* role: `mac` on Darwin, `desktop` on Linux. */ -}}
{{- $defaultRole := "desktop" -}}
{{- if $isDarwin }}{{ $defaultRole = "mac" }}{{ end -}}

{{- /*
     Login shell, consumed by dot_config/kitty/kitty.conf.tmpl.

     Darwin uses /bin/zsh — the system zsh — deliberately, not a Homebrew
     one. It is already this user's login shell (`dscl . -read /Users/volodia
     UserShell`), so kitty and the login shell agree; it needs no formula and
     no /etc/shells edit; and it survives the nix-darwin uninstall. The
     previous default pointed at /opt/homebrew/bin/zsh, which does not exist
     and is not declared in brew_formulae. Version-wise this costs nothing:
     system 5.9 vs Homebrew 5.9.2.
*/ -}}
{{- $defaultShell := "/usr/bin/zsh" -}}
{{- if $isDarwin }}{{ $defaultShell = "/bin/zsh" }}{{ end -}}

{{- /*
     host must match the Ansible inventory host name, since the two configs
     describe the same machine. On Linux .chezmoi.hostname already is that
     name; on Darwin it is the Sharing-preferences computer name
     ("Volodias-MacBook-Pro"), which is not it — hence the override.
*/ -}}
{{- $defaultHost := .chezmoi.hostname -}}
{{- if $isDarwin }}{{ $defaultHost = "macbook" }}{{ end -}}

{{- $host       := promptStringOnce . "host"        "Short host name"                        $defaultHost -}}
{{- $role       := promptStringOnce . "role"        "Role (desktop|mac)"                     $defaultRole -}}
{{- $flavor     := promptStringOnce . "flavor"      "Catppuccin flavor (mocha|latte)"        "mocha" -}}
{{- $name       := promptStringOnce . "name"        "Full name"                              "Volodia P.G." -}}
{{- $username   := promptStringOnce . "username"    "User name"                              .chezmoi.username -}}
{{- $email      := promptStringOnce . "email"       "Email"                                  "volodia.parol-guarino@proton.me" -}}
{{- $signingKey := promptStringOnce . "signing_key" "SSH signing key"                        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH7eU7+cUxzOuU3lfwKODvOvCVa6PM635CwP66Qv05RT" -}}
{{- $shell      := promptStringOnce . "shell"       "Login shell (absolute path)"            $defaultShell -}}

{{- /*
     This repo is not at chezmoi's default source location
     (~/.local/share/chezmoi), so the path chosen at `init --source=...` has
     to be recorded here — the generated config REPLACES anything init would
     otherwise write, and a config emitting only [data] silently leaves
     sourceDir at the default, making every later command fail with
     `stat ~/.local/share/chezmoi: no such file or directory`.

     .chezmoi.sourceDir is the already-resolved directory, i.e. <repo>/chezmoi
     with .chezmoiroot applied, so writing it here is correct on any machine
     and at any checkout path.
*/ -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
host = {{ $host | quote }}
role = {{ $role | quote }}
flavor = {{ $flavor | quote }}
name = {{ $name | quote }}
username = {{ $username | quote }}
email = {{ $email | quote }}
signing_key = {{ $signingKey | quote }}
shell = {{ $shell | quote }}
home_dir = {{ .chezmoi.homeDir | quote }}
