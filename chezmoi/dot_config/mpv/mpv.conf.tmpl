profile=gpu-hq

vo=gpu-next
{{- if eq .chezmoi.os "linux" }}
# SVP (ansible/roles/svp). SVPManager finds mpv through this socket, and
# its VapourSynth filter needs decoded frames copied back to system memory.
input-ipc-server=/tmp/mpvsocket
hwdec=auto-copy

ao=alsa
#ao=pipewire

# SVP's bundled mpv has no ao=pipewire, so it plays through pipewire-pulse.
# mpv's default pulse-latency-hacks=yes derives the delay from the stream's
# write/read indexes, which PipeWire advances one graph quantum (here 2048
# samples, ~43 ms) at a time: mpv's audio clock becomes a sawtooth and video
# timed against it judders. PulseAudio's interpolated timing is smooth.
# (ao=alsa is smooth too, but with the default audio-channels=auto-safe it
# downmixes 5.1 to stereo.)
pulse-latency-hacks=no
{{- else }}
hwdec=auto-safe
{{- end }}

audio-channels=auto

hdr-compute-peak=no

# wayland-disable-vsync=yes
# video-sync=display-resample

# Enable VRR for Linux DRM/KMS outputs (if applicable)
drm-vrr-enabled=yes

interpolation=no

# osd-msg1="FPS: ${estimated-display-fps}"

target-trc=srgb


ytdl-format=bestvideo[height<=?1080]+bestaudio/best
cache=yes
cache-pause=yes
cache-pause-wait=1
cache-secs=120
