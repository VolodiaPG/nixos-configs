# Aliases — PLAN.MD task 2.6, from modules/home/zsh.nix shellAliases.

alias c='clear'
alias g='git'
alias ga='git add .'
alias gm='git commit -m'
alias j='just'
alias jl='just --list'
alias journalctl-10min="journalctl --user -xe -b --since '10 min ago'"
alias ll='ls -l'
alias n='nvim'
alias k='kubectl'

{{ if eq .chezmoi.os "darwin" -}}
alias appmem='ps -axo rss=,pcpu=,comm= | awk '\''{m=$1/1024; c=$2; $1=$2=""; sub(/^ +/,""); n=$0; if (match(n,/[^\/]+\.app/)) n=substr(n,RSTART,RLENGTH); else sub(/.*\//,"",n); sm[n]+=m; sc[n]+=c} END{for(k in sm) printf "%8.0f MB %6.1f%% %s\n", sm[k], sc[k], k}'\'' | sort -rn | head -20'
{{- else -}}
alias appmem='ps -eo rss=,pcpu=,comm= | awk '\''{m=$1/1024; c=$2; $1=$2=""; sub(/^ +/,""); n=$0; sm[n]+=m; sc[n]+=c} END{for(k in sm) printf "%8.0f MB %6.1f%% %s\n", sm[k], sc[k], k}'\'' | sort -rn | head -20'
{{- end }}

