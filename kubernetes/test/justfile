init:
    rm kubeconfig || true
    terraform init && terraform apply
    ansible-galaxy collection install -r requirements.yml
    ansible-playbook -i inventory.yml playbook.yml
    sed "s/127.0.0.1/$(terraform output --raw ip)/g" kubeconfig
    KUBECONFIG=./kubeconfig kubectl get nodes

playbook:
    ansible-playbook -i inventory.yml playbook.yml

stop:
    multipass stop $(terraform output --raw multipass)

start:
    multipass start $(terraform output --raw multipass)

destroy:
    terraform destroy
